# Copy to .env and fill in. Real environment variables override this file.

# Which language model answers: ollama (default) | openai_compatible | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Ollama only: context window size in tokens
LLM_NUM_CTX=
# Anthropic only: max reply length
LLM_MAX_TOKENS=

# Free key from https://openalex.org/settings/api (needs the emailed
# activation link clicked before it works)
OPENALEX_API_KEY=

# Which tools the model gets and how they are set up (see profiles.example.toml):
#   auto (default)  small for Ollama or a localhost server, large for hosted services
#   small | large   force one. Running a big model on Ollama? Set large.
#   <name>          a profile you defined in profiles.toml
LLM_PROFILE=auto
